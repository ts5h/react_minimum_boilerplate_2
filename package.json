{
  "name": "react_minimum_boilerplate_2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "biome format --write ./src && prettier --write \"./src/**/*.scss\"",
    "lint": "biome lint ./src",
    "lint:fix": "biome check --write ./src",
    "preview": "vite preview",
    "start": "pnpm run dev"
  },
  "dependencies": {
    "jotai": "^2.19.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "prettier": "3.8.1",
    "sass": "^1.98.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.3"
  },
  "packageManager": "pnpm@10.33.0"
}
